# Generated files that tests compare byte for byte with what they generate: LF on every OS, also
# where Git for Windows' core.autocrlf would check them out with CRLF.
docs/launcher-commands.md text eol=lf
docs/horizon-ctl-commands.md text eol=lf
crates/horizon-theme/tokens.css text eol=lf
docs/api/*-reference.md text eol=lf
crates/horizon-mod-api-gen/crossing-foreign.json text eol=lf
# The package layout's one number, read by Rust, Python and shell alike.
crates/horizon-mod-package/src/sdk/package-format text eol=lf

launcher/lang/*.json merge=horizon-lang
crates/horizon-client/assets/horizon/lang/*.json merge=horizon-lang

# The carried horizon-mixins patch is hashed into its tool's release tag: the same bytes on every OS.
tools/mixins/*.patch text eol=lf
