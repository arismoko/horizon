ARG DYNA_BASE
FROM ${DYNA_BASE}
USER root
# apt's sandbox user needs GID 65534, which a host with a short subuid range does not map.
RUN echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/10dyna \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates cmake curl jq patchelf pkg-config python3 ripgrep \
    libasound2-dev libfontconfig-dev libudev-dev libvulkan-dev libwayland-dev libx11-xcb-dev libxkbcommon-x11-dev \
    libegl1 libgl1 libx11-6 libxcursor1 libxi6 libxinerama1 libxkbcommon-x11-0 libxrandr2 \
    mesa-vulkan-drivers vulkan-tools xauth xvfb \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL "https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.5%2B8/OpenJDK25U-jdk_x64_linux_hotspot_25.0.5_8.tar.gz" -o /tmp/jdk.tar.gz \
    && echo "68982529869257d0ee6b824ec5aa270ff8b118bb438670da0b97ebdab178d7fb  /tmp/jdk.tar.gz" | sha256sum -c - \
    && mkdir -p /opt/java && tar -C /opt/java --strip-components=1 -xzf /tmp/jdk.tar.gz && rm /tmp/jdk.tar.gz
RUN curl -fsSL https://static.rust-lang.org/rustup/archive/1.29.2/x86_64-unknown-linux-gnu/rustup-init -o /tmp/rustup-init \
    && echo "5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo /tmp/rustup-init -y --no-modify-path --profile minimal \
       --default-toolchain 1.99.1 --component rustfmt --component clippy \
    && rm /tmp/rustup-init && chmod -R a+rX /opt/rustup
USER node
ENV PATH="/opt/rustup/toolchains/1.99.1-x86_64-unknown-linux-gnu/bin:/opt/java/bin:${PATH}" JAVA_HOME=/opt/java VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.x86_64.json HORIZON_NO_AUDIO=1
