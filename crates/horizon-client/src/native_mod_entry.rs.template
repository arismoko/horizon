//! Per-library entry module generated by the launcher.
extern crate mod_api;

macro_rules! native_mods {
    ($($id:literal => $hooks:path,)*) => {
        vec![$(mod_api::ModEntry::new($id, $hooks()),)*]
    };
}

#[inline(never)]
pub fn entries() -> Vec<mod_api::ModEntry> {
    native_mods! {
    /* MOD_ENTRIES */
    }
}

#[inline(never)]
pub fn slots() -> Vec<mod_api::__private::points::SlotListener> {
    vec![
/* MOD_SLOTS */
    ]
}

fn installs() -> Vec<(&'static str, &'static [&'static str], bool)> {
    vec![
/* MOD_REDIRECTS */
    ]
}
static BUILT: &[mod_api::__private::native::BuiltMod] = &[
/* BUILT_MODS */
];
#[unsafe(no_mangle)]
pub extern "C" fn horizon_native_build() -> *const std::os::raw::c_char {
    b"/* NATIVE_BUILD */\0".as_ptr().cast()
}
#[unsafe(no_mangle)]
pub fn horizon_native_mod_v1() -> &'static mod_api::__private::native::NativeMod {
    static MOD: std::sync::OnceLock<mod_api::__private::native::NativeMod> = std::sync::OnceLock::new();
    MOD.get_or_init(|| mod_api::__private::native::NativeMod::new(entries, slots, BUILT, installs))
}
