//! Generated by the launcher: the instance's API-only native mods, as the `horizon_native_mods`
//! library the prebuilt executable on the API route loads. The SDK builds the same file with no
//! rows as the stub the executable links against; the launcher's build replaces that file.
macro_rules! native_mods {
    ($($id:literal => $hooks:path,)*) => {
        vec![$(mod_api::ModEntry::new($id, $hooks()),)*]
    };
}

#[inline(never)]
pub fn entries() -> Vec<mod_api::ModEntry> {
    native_mods! {
    /* MOD_ENTRIES */
    }
}

#[inline(never)]
pub fn slots() -> Vec<mod_api::__private::points::SlotListener> {
    vec![
/* MOD_SLOTS */
    ]
}

#[inline(never)]
pub fn built() -> &'static [mod_api::__private::native::BuiltMod] {
    &[
/* BUILT_MODS */
    ]
}
